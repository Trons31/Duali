{
  "name": "@pagos/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo-studio.ts",
    "prisma": "prisma",
    "test": "npm run test:unit && npm run test:functional",
    "test:all": "npm test && npm run test:e2e",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:functional": "node --import tsx --test --test-concurrency=1 --test-global-setup=tests/functional/global-setup.mts \"tests/functional/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test --test-concurrency=1 --test-timeout=300000 --test-global-setup=tests/e2e/global-setup.mts \"tests/e2e/**/*.e2e.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo-server-sdk": "^3.14.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "postcss": "^8.5.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "sileo": "^0.1.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "17.10.0-beta.17",
    "playwright-core": "^1.63.0",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14"
    },
    "tsx": {
      "esbuild": "0.28.1"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
