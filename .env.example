# En serverless/Fluid: 1 conexion por instancia y timeouts cortos. Esperar 60s por
# una conexion significa 60s de memoria provisionada facturada por request fallido.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1&pool_timeout=10&connect_timeout=5"
PRISMA_CONNECTION_LIMIT="1"
DIRECT_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
DEFAULT_WHATSAPP_COUNTRY_CODE="57"
CRON_SECRET=""
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_PASSWORD_HASH=""
DUALI_DEFAULT_PLAN_PRICE="50000"
DUALI_DEFAULT_PLAN_NAME="Plan Duali"
DUALI_DEFAULT_PLAN_DESCRIPTION="Acceso completo al panel web, gestión de estudiantes, grupos, cobros, egresos, contabilidad y recordatorios."
WEB_PUSH_SUBJECT="mailto:admin@example.com"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# --- Control de consumo del cron -------------------------------------------
# Presupuesto de tiempo por invocacion de cron (ms). La funcion devuelve
# resultados parciales antes de agotarlo en vez de expirar con 504 a los 300s.
CRON_TIME_BUDGET_MS="40000"
# Antiguedad maxima (dias) de los cobros vencidos que generan recordatorio.
REMINDER_OVERDUE_WINDOW_DAYS="45"
# pg_try_advisory_lock solo funciona sin pooler transaccional (pgbouncer=true).
# Dejar en false salvo que el cron apunte a DIRECT_URL.
NOTIFICATION_ADVISORY_LOCK="false"
