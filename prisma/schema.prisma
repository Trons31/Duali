generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StudentStatus {
  ACTIVO
  PAUSADO
  DESACTIVADO
  INACTIVO
}

enum MonthlyBillingMode {
  ANTICIPADA
  VENCIDA
}

enum MonthlyPaymentStatus {
  PENDIENTE
  ABONADO
  PAGADO
  VENCIDO
  NO_APLICA
}

enum SuppliesPaymentStatus {
  PENDIENTE
  PAGADO
}

enum EnrollmentPaymentStatus {
  PENDIENTE
  ABONADO
  PAGADO
  VENCIDO
}

enum ReminderStatus {
  PENDIENTE
  ENVIADO
  FALLIDO
}

enum NotificationStatus {
  PENDIENTE
  ENVIADA
  FALLIDA
  LEIDA
}

enum NotificationQueueStatus {
  ENCOLADA
  PROCESANDO
  REINTENTANDO
  ENVIADA
  FALLIDA
}

enum NotificationDeliveryStatus {
  OMITIDA
  ENVIADA
  ENTREGADA
  FALLIDA
}

enum NotificationChannel {
  INBOX_SYNC
  EXPO
  WEB_PUSH
}

enum DisciplineKind {
  CLASE
  COMBO
}

enum BookingStatus {
  RESERVADA
  ASISTIO
  NO_ASISTIO
  CANCELADA
}

enum BookingOrigin {
  PANEL
  PUBLICO
}

enum ContentType {
  PUBLICACION
  VIDEO
}

enum StudioMessageType {
  RECORDATORIO_CLASE
  PAQUETE_POR_VENCER
  SALDO
  CLASE_CANCELADA
  CUPO_LISTA_ESPERA
}

enum WaitlistStatus {
  EN_ESPERA
  ASIGNADA
  SALIO
}

enum PaymentReceiptStatus {
  POR_REVISAR
  APROBADO
  RECHAZADO
}

enum SubscriptionStatus {
  ACTIVA
  PENDIENTE
  SUSPENDIDA
  CANCELADA
  VENCIDA
}

model Client {
  id                        String    @id @default(cuid())
  nombre                    String
  email                     String    @unique
  passwordHash              String
  telefono                  String?
  businessName              String
  paymentMethods            String?
  paymentMethodItems        Json?
  whatsappMessageTemplate   String?
  moduloAcademia            Boolean   @default(true)
  moduloEstudio             Boolean   @default(false)
  // Spec 007: horas de anticipacion para cancelar una reserva y recuperar la clase.
  horasCancelacion          Int       @default(2)
  // Spec 019 D4: si no asiste, se le devuelve la clase (por defecto, la pierde).
  devolverClaseInasistencia Boolean   @default(false)
  // Spec 021 D2/D3: pagos en linea.
  permitirPagoEnEstudio     Boolean   @default(false)
  exigirPagoValidado        Boolean   @default(false)
  // Spec 008: direccion publica /s/{slug}; nadie queda publicado sin activarlo.
  slug                      String?   @unique
  paginaPublicaActiva       Boolean   @default(false)
  // Spec 010: portada de la pagina publica (Cloudinary).
  portadaUrl                String?
  portadaPublicId           String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  groups                 Group[]
  students               Student[]
  monthlyPayments        MonthlyPayment[]
  suppliesPayments       SuppliesPayment[]
  enrollmentPayments     EnrollmentPayment[]
  paymentInstallments    PaymentInstallment[]
  expenses               Expense[]
  notifications          Notification[]
  notificationOutboxes   NotificationOutbox[]
  notificationDeliveries NotificationDelivery[]
  reminders              Reminder[]
  pushTokens             PushToken[]
  webPushSubscriptions   WebPushSubscription[]
  subscriptions          ClientSubscription[]
  subscriptionPayments   SubscriptionPayment[]
  disciplines            Discipline[]
  packages               Package[]
  classSchedules         ClassSchedule[]
  classSessions          ClassSession[]
  studioMembers          StudioMember[]
  memberPackages         MemberPackage[]
  memberPackagePayments  MemberPackagePayment[]
  bookings               Booking[]
  contentPosts           ContentPost[]
  studioMessages         StudioMessage[]
  paymentReceipts        PaymentReceipt[]
  waitlistEntries        WaitlistEntry[]

  @@index([email])
  @@map("clients")
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(12, 2)
  features    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions ClientSubscription[]

  @@index([isActive])
  @@map("plans")
}

model ClientSubscription {
  id            String             @id @default(cuid())
  clientId      String
  planId        String
  status        SubscriptionStatus @default(ACTIVA)
  price         Decimal            @db.Decimal(12, 2)
  startedAt     DateTime
  endsAt        DateTime
  nextBillingAt DateTime
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments SubscriptionPayment[]

  @@index([clientId])
  @@index([planId])
  @@index([status, nextBillingAt])
  @@map("client_subscriptions")
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  clientId       String
  amount         Decimal  @db.Decimal(12, 2)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime @default(now())
  paymentMethod  String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([clientId])
  @@index([clientId, paidAt])
  @@map("subscription_payments")
}

model WebPushConfig {
  id         String   @id
  publicKey  String   @unique
  privateKey String
  subject    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("web_push_config")
}

model Group {
  id                       String    @id @default(cuid())
  nombre                   String
  descripcion              String?
  precioMensualidadDefault Decimal   @db.Decimal(12, 2)
  clientId                 String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  students         Student[]
  monthlyPayments  MonthlyPayment[]
  suppliesPayments SuppliesPayment[]

  @@index([clientId])
  @@index([clientId, nombre])
  @@map("groups")
}

model Student {
  id                   String             @id @default(cuid())
  nombre               String
  apellido             String
  edad                 Int
  celular              String?
  esMenorDeEdad        Boolean            @default(false)
  nombrePadre          String?
  telefonoPadre        String?
  parentesco           String?
  grupoId              String
  clientId             String
  estado               StudentStatus      @default(ACTIVO)
  precioMensualidad    Decimal?           @db.Decimal(12, 2)
  diaCobro             Int?
  modalidadMensualidad MonthlyBillingMode @default(ANTICIPADA)
  fechaInicioClases    DateTime?
  fechaInicioPausa     DateTime?
  fechaFinPausa        DateTime?
  motivoEstado         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group               Group                @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  monthlyPayments     MonthlyPayment[]
  suppliesPayments    SuppliesPayment[]
  enrollmentPayment   EnrollmentPayment?
  paymentInstallments PaymentInstallment[]
  reminders           Reminder[]
  studioMembers       StudioMember[]

  @@index([clientId])
  @@index([grupoId])
  @@index([clientId, estado])
  @@index([clientId, fechaInicioClases])
  @@index([clientId, nombre, apellido])
  @@map("students")
}

model EnrollmentPayment {
  id                  String                  @id @default(cuid())
  estudianteId        String                  @unique
  clientId            String
  monto               Decimal                 @db.Decimal(12, 2)
  montoAbonado        Decimal                 @default(0) @db.Decimal(12, 2)
  saldoPendiente      Decimal                 @default(0) @db.Decimal(12, 2)
  cantidadAbonos      Int                     @default(0)
  estado              EnrollmentPaymentStatus @default(PENDIENTE)
  fechaVencimiento    DateTime
  fechaPago           DateTime?
  fechaRegistro       DateTime?
  metodoPago          String?
  registradoPorUserId String?
  registradoPorNombre String?
  ultimoMetodoAbono   String?
  fechaUltimoAbono    DateTime?
  notas               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  installments PaymentInstallment[]
  reminders    Reminder[]

  @@index([clientId])
  @@index([estudianteId])
  @@index([clientId, estado])
  @@index([clientId, fechaVencimiento])
  @@map("enrollment_payments")
}

model MonthlyPayment {
  id                  String               @id @default(cuid())
  estudianteId        String
  grupoId             String
  clientId            String
  mes                 Int
  anio                Int
  monto               Decimal              @db.Decimal(12, 2)
  montoAbonado        Decimal              @default(0) @db.Decimal(12, 2)
  saldoPendiente      Decimal              @default(0) @db.Decimal(12, 2)
  cantidadAbonos      Int                  @default(0)
  fechaVencimiento    DateTime
  fechaPago           DateTime?
  fechaRegistro       DateTime?
  estado              MonthlyPaymentStatus @default(PENDIENTE)
  metodoPago          String?
  registradoPorUserId String?
  registradoPorNombre String?
  ultimoMetodoAbono   String?
  fechaUltimoAbono    DateTime?
  comprobanteUrl      String?
  notas               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  group        Group                @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  installments PaymentInstallment[]
  reminders    Reminder[]

  @@unique([estudianteId, mes, anio])
  @@index([clientId])
  @@index([grupoId])
  @@index([estudianteId])
  @@index([clientId, estado])
  @@index([clientId, fechaVencimiento])
  @@map("monthly_payments")
}

model PaymentInstallment {
  id                  String   @id @default(cuid())
  clientId            String
  estudianteId        String
  monthlyPaymentId    String?
  enrollmentPaymentId String?
  numero              Int
  concepto            String
  monto               Decimal  @db.Decimal(12, 2)
  metodoPago          String
  fechaAbono          DateTime
  saldoAnterior       Decimal  @db.Decimal(12, 2)
  saldoRestante       Decimal  @db.Decimal(12, 2)
  registradoPorUserId String?
  registradoPorNombre String?
  notas               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  student           Student            @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  monthlyPayment    MonthlyPayment?    @relation(fields: [monthlyPaymentId], references: [id], onDelete: Cascade)
  enrollmentPayment EnrollmentPayment? @relation(fields: [enrollmentPaymentId], references: [id], onDelete: Cascade)

  @@unique([monthlyPaymentId, numero])
  @@unique([enrollmentPaymentId, numero])
  @@index([clientId])
  @@index([estudianteId])
  @@index([monthlyPaymentId])
  @@index([enrollmentPaymentId])
  @@index([clientId, fechaAbono])
  @@map("payment_installments")
}

model SuppliesPayment {
  id               String                @id @default(cuid())
  nombreConcepto   String
  descripcion      String?
  monto            Decimal               @db.Decimal(12, 2)
  grupoId          String?
  estudianteId     String?
  clientId         String
  estado           SuppliesPaymentStatus @default(PENDIENTE)
  fechaVencimiento DateTime
  fechaPago        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group   Group?   @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [estudianteId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([grupoId])
  @@index([estudianteId])
  @@index([clientId, estado])
  @@index([clientId, fechaVencimiento])
  @@map("supplies_payments")
}

model Expense {
  id          String    @id @default(cuid())
  clientId    String
  concepto    String
  descripcion String?
  monto       Decimal   @db.Decimal(12, 2)
  fecha       DateTime
  categoria   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, fecha])
  @@index([clientId, categoria])
  @@map("expenses")
}

model PushToken {
  id         String   @id @default(cuid())
  clientId   String
  token      String   @unique
  platform   String?
  deviceName String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("push_tokens")
}

model WebPushSubscription {
  id             String   @id @default(cuid())
  clientId       String
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime BigInt?
  userAgent      String?
  deviceName     String?
  isActive       Boolean  @default(true)
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, isActive])
  @@map("web_push_subscriptions")
}

model Notification {
  id            String             @id @default(cuid())
  sequence      Int                @default(autoincrement())
  clientId      String
  title         String
  body          String
  data          Json?
  type          String?
  dedupKey      String?            @unique
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  status        NotificationStatus @default(PENDIENTE)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  error         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  client     Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  outbox     NotificationOutbox?
  deliveries NotificationDelivery[]

  @@index([clientId])
  @@index([clientId, sequence])
  @@index([clientId, status])
  @@index([status, nextAttemptAt])
  @@index([clientId, type])
  @@map("notifications")
}

model NotificationOutbox {
  id                  String                  @id @default(cuid())
  notificationId      String                  @unique
  clientId            String
  status              NotificationQueueStatus @default(ENCOLADA)
  attemptCount        Int                     @default(0)
  nextAttemptAt       DateTime                @default(now())
  processingStartedAt DateTime?
  lastAttemptAt       DateTime?
  sentAt              DateTime?
  lastError           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  clientId          String
  channel           NotificationChannel
  attempt           Int                        @default(1)
  status            NotificationDeliveryStatus @default(ENVIADA)
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([clientId, channel])
  @@index([notificationId, status])
  @@map("notification_deliveries")
}

model Reminder {
  id                  String         @id @default(cuid())
  clientId            String
  estudianteId        String
  monthlyPaymentId    String?
  enrollmentPaymentId String?
  phone               String
  message             String
  whatsappUrl         String
  status              ReminderStatus @default(PENDIENTE)
  sentAt              DateTime?
  error               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  student           Student            @relation(fields: [estudianteId], references: [id], onDelete: Restrict)
  monthlyPayment    MonthlyPayment?    @relation(fields: [monthlyPaymentId], references: [id], onDelete: SetNull)
  enrollmentPayment EnrollmentPayment? @relation(fields: [enrollmentPaymentId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([estudianteId])
  @@index([monthlyPaymentId])
  @@index([enrollmentPaymentId])
  @@index([clientId, status])
  @@map("reminders")
}

// ─── Modo Estudio (specs 003 y 004) ──────────────────────────────────────────

model Discipline {
  id             String         @id @default(cuid())
  clientId       String
  tipo           DisciplineKind @default(CLASE)
  nombre         String
  descripcion    String?
  color          String
  imagenUrl      String?
  imagenPublicId String?
  orden          Int            @default(0)
  activa         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Si es COMBO: las clases que incluye. Si es CLASE: los combos en los que esta.
  comboItems     DisciplineComboItem[] @relation("ComboItems")
  inCombos       DisciplineComboItem[] @relation("ComboMember")
  packages       Package[]
  schedules      ClassSchedule[]
  memberPackages MemberPackage[]
  contentPosts   ContentPost[]

  @@index([clientId])
  @@index([clientId, deletedAt])
  @@map("disciplines")
}

model DisciplineComboItem {
  comboId      String
  disciplineId String

  combo      Discipline @relation("ComboItems", fields: [comboId], references: [id], onDelete: Cascade)
  discipline Discipline @relation("ComboMember", fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([comboId, disciplineId])
  @@index([disciplineId])
  @@map("discipline_combo_items")
}

model Package {
  id             String    @id @default(cuid())
  clientId       String
  disciplineId   String
  nombre         String
  clases         Int
  precio         Decimal   @db.Decimal(12, 2)
  vigenciaDias   Int       @default(30)
  visiblePublico Boolean   @default(true)
  activo         Boolean   @default(true)
  orden          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  discipline Discipline      @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  sales      MemberPackage[]

  @@index([clientId])
  @@index([disciplineId])
  @@index([clientId, deletedAt])
  @@map("packages")
}

// ─── Modo Estudio: horario y cupos (spec 005) ────────────────────────────────

model ClassSchedule {
  id           String    @id @default(cuid())
  clientId     String
  disciplineId String
  // 1 = lunes ... 7 = domingo (ISO).
  diaSemana    Int
  // Hora "de pared" del estudio, "HH:mm".
  horaInicio   String
  duracionMin  Int
  cupo         Int
  instructor   String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  discipline Discipline     @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  sessions   ClassSession[]

  @@index([clientId, deletedAt])
  @@index([disciplineId])
  @@map("class_schedules")
}

// Solo existe cuando una fecha necesita datos propios (cupo, cancelacion, reservas).
model ClassSession {
  id                String   @id @default(cuid())
  clientId          String
  scheduleId        String
  fecha             DateTime @db.Date
  horaInicio        String
  duracionMin       Int
  cupo              Int
  cancelada         Boolean  @default(false)
  motivoCancelacion String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  schedule        ClassSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@unique([scheduleId, fecha])
  @@index([clientId, fecha])
  @@map("class_sessions")
}

// ─── Modo Estudio: clientes y ventas (spec 006) ──────────────────────────────

model StudioMember {
  id              String    @id @default(cuid())
  clientId        String
  nombre          String
  apellido        String?
  // Solo digitos, sin indicativo 57.
  celular         String
  email           String?
  fechaNacimiento DateTime? @db.Date
  notas           String?
  studentId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  student         Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  packages        MemberPackage[]
  bookings        Booking[]
  messages        StudioMessage[]
  waitlistEntries WaitlistEntry[]

  @@unique([clientId, celular])
  @@index([clientId, deletedAt])
  @@index([studentId])
  @@map("studio_members")
}

// nombre, clases y precio se copian al vender: cambiar el catalogo no altera ventas.
model MemberPackage {
  id              String        @id @default(cuid())
  clientId        String
  memberId        String
  packageId       String
  disciplineId    String
  nombre          String
  clases          Int
  clasesUsadas    Int           @default(0)
  precio          Decimal       @db.Decimal(12, 2)
  pagado          Decimal       @default(0) @db.Decimal(12, 2)
  inicio          DateTime      @db.Date
  vence           DateTime      @db.Date
  anuladoAt       DateTime?
  motivoAnulacion String?
  notas           String?
  // Spec 021: compra desde la pagina publica y enlace privado "Mi plan".
  origen          BookingOrigin @default(PANEL)
  accessToken     String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client     Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member     StudioMember           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  package    Package                @relation(fields: [packageId], references: [id], onDelete: Restrict)
  discipline Discipline             @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  payments   MemberPackagePayment[]
  bookings   Booking[]
  receipts   PaymentReceipt[]

  @@index([clientId, vence])
  @@index([memberId])
  @@index([packageId])
  @@map("member_packages")
}

model MemberPackagePayment {
  id              String    @id @default(cuid())
  clientId        String
  memberPackageId String
  monto           Decimal   @db.Decimal(12, 2)
  metodoPago      String
  fecha           DateTime
  notas           String?
  anuladoAt       DateTime?
  createdAt       DateTime  @default(now())

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id], onDelete: Restrict)

  @@index([clientId, fecha])
  @@index([memberPackageId])
  @@map("member_package_payments")
}

// ─── Modo Estudio: reservas (spec 007) ───────────────────────────────────────

// La clase se descuenta del paquete al reservar (D2); claseDevuelta indica si se
// devolvio al cancelar.
model Booking {
  id              String        @id @default(cuid())
  clientId        String
  sessionId       String
  memberId        String
  memberPackageId String
  estado          BookingStatus @default(RESERVADA)
  origen          BookingOrigin @default(PANEL)
  canceladaAt     DateTime?
  claseDevuelta   Boolean       @default(false)
  // Spec 009: enlace privado de las reservas hechas desde la pagina publica.
  accessToken     String?       @unique
  // Spec 019: cuando se marco la asistencia, y si llego sin reservar.
  asistenciaAt    DateTime?
  sinReserva      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session       ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  member        StudioMember  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id], onDelete: Restrict)

  @@unique([sessionId, memberId])
  @@index([clientId])
  @@index([memberId])
  @@index([memberPackageId])
  @@map("bookings")
}

// ─── Modo Estudio: contenido (spec 010) ──────────────────────────────────────

// Archivos en Cloudinary: duali/negocios/{clientId}/imagenes|videos/publicaciones.
model ContentPost {
  id            String      @id @default(cuid())
  clientId      String
  tipo          ContentType
  titulo        String
  cuerpo        String?
  disciplineId  String?
  mediaUrl      String?
  mediaPublicId String?
  // "IMAGEN" | "VIDEO"
  mediaKind     String?
  enlaceVideo   String?
  publicado     Boolean     @default(false)
  fijado        Boolean     @default(false)
  publicadoEn   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: SetNull)

  @@index([clientId, deletedAt])
  @@index([clientId, publicado])
  @@map("content_posts")
}

// ─── Modo Estudio: avisos por WhatsApp enviados (spec 011) ───────────────────

model StudioMessage {
  id        String            @id @default(cuid())
  clientId  String
  memberId  String
  tipo      StudioMessageType
  // Reserva, venta o clase+fecha a la que se refiere el aviso.
  refKey    String
  sentAt    DateTime          @default(now())
  createdAt DateTime          @default(now())

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  member StudioMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([clientId, tipo, refKey])
  @@index([memberId])
  @@map("studio_messages")
}

// ─── Modo Estudio: comprobantes de pago enviados desde la web (spec 014) ─────

// Foto en duali/negocios/{clientId}/imagenes/comprobantes.
model PaymentReceipt {
  id              String               @id @default(cuid())
  clientId        String
  memberPackageId String
  bookingId       String?
  url             String
  publicId        String
  // Spec 021: el metodo que eligio la clienta al pagar (nombre del metodo del estudio).
  metodoPago      String?
  estado          PaymentReceiptStatus @default(POR_REVISAR)
  paymentId       String?
  motivoRechazo   String?
  createdAt       DateTime             @default(now())
  reviewedAt      DateTime?

  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id], onDelete: Cascade)

  @@index([clientId, estado])
  @@index([memberPackageId])
  @@map("payment_receipts")
}

// Spec 015: lista de espera de una clase llena.
model WaitlistEntry {
  id          String         @id @default(cuid())
  clientId    String
  sessionId   String
  memberId    String
  // Plan del catalogo que eligio comprar si al asignarle cupo no tiene uno vigente.
  packageId   String?
  accessToken String         @unique
  estado      WaitlistStatus @default(EN_ESPERA)
  bookingId   String?
  // Orden de llegada.
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client  Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  StudioMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([clientId, estado])
  @@index([sessionId, estado, createdAt])
  @@map("waitlist_entries")
}
